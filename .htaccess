# Sin listados de carpetas
Options -Indexes

# Documentación interna y archivos de control: no se publican
<FilesMatch "(?i)(\.md|\.sql|\.gitignore|\.git.*)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
RedirectMatch 404 /\.git

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Las páginas se revalidan siempre: así apuntan a la versión nueva del CSS/JS (?v=...)
<FilesMatch "\.html?$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</FilesMatch>

# URLs limpias: /inicio, /catalogo, /nosotros, /contacto (sin .html)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Una sola dirección para el sitio: https://arecold.com.ar (sin www y siempre con HTTPS)
  RewriteCond %{HTTP_HOST} ^www\.arecold\.com\.ar$ [NC]
  RewriteRule ^(.*)$ https://arecold.com.ar/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^arecold\.com\.ar$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://arecold.com.ar/$1 [R=301,L]

  # Si alguien entra con .html, se lo lleva a la dirección limpia
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+index\.html[\s?]
  RewriteRule ^index\.html$ inicio [R=301,L]
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+(catalogo|nosotros|contacto)\.html[\s?]
  RewriteRule ^(catalogo|nosotros|contacto)\.html$ $1 [R=301,L]

  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+admin/index\.html[\s?]
  RewriteRule ^admin/index\.html$ admin/ [R=301,L]

  # La dirección limpia sirve el archivo de siempre
  RewriteRule ^inicio/?$ index.html [L]
  RewriteRule ^(catalogo|nosotros|contacto)/?$ $1.html [L]
</IfModule>

# Páginas de error propias
ErrorDocument 404 /404.html

# Compresión: las páginas, estilos y scripts viajan más livianos
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

# Caché del navegador: estilos y scripts llevan ?v=..., así que pueden guardarse mucho tiempo;
# las fotos (assets y uploads) tienen nombre propio y casi no cambian
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
